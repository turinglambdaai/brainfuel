<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BrainFuel">

    <Grid x:Name="RootGrid" Background="Transparent">
        <StackPanel
            x:Name="BootPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">
            <InfoBar
                x:Name="StatusBar"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Message="Starting embedded Racket CS…" />
        </StackPanel>

        <!-- standard floating card -->
        <Border
            x:Name="CardBorder"
            Width="368"
            Height="226"
            Padding="14"
            CornerRadius="16"
            BorderThickness="1"
            Visibility="Collapsed">
            <Border.BorderBrush>
                <SolidColorBrush Color="#807872" Opacity="0.13" />
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0">
                    <StackPanel Spacing="1">
                        <TextBlock
                            x:Name="TitleText"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="BrainFuel" />
                        <TextBlock
                            x:Name="SubtitleText"
                            FontSize="11"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        x:Name="MenuButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="&#xE712;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuDetail" Click="OnMenuDetailClick" />
                                <MenuFlyoutItem x:Name="MenuRefresh" Click="OnMenuRefreshClick" />
                                <MenuFlyoutSubItem x:Name="MenuAccounts" />
                                <MenuFlyoutItem x:Name="MenuSettings" Click="OnMenuSettingsClick" />
                                <ToggleMenuFlyoutItem x:Name="MenuTopmost" Click="OnMenuTopmostClick" />
                                <MenuFlyoutItem x:Name="MenuMini" Click="OnMenuMiniClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuQuit" Click="OnMenuQuitClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- body: rings + chips -->
                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="0"
                        Width="96"
                        Height="96"
                        VerticalAlignment="Center">
                        <Ellipse
                            x:Name="WeeklyTrack"
                            Width="88"
                            Height="88"
                            StrokeThickness="9" />
                        <Ellipse
                            x:Name="WeeklyRing"
                            Width="88"
                            Height="88"
                            StrokeThickness="9"
                            StrokeDashCap="Round"
                            RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            x:Name="HourlyTrack"
                            Width="62"
                            Height="62"
                            StrokeThickness="7" />
                        <Ellipse
                            x:Name="HourlyRing"
                            Width="62"
                            Height="62"
                            StrokeThickness="7"
                            StrokeDashCap="Round"
                            RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse
                                x:Name="HourlyDot"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="HourlyTitle"
                                FontSize="10"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            x:Name="HourlyPercent"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="HourlyReset"
                            FontSize="9"
                            Text="--" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse
                                x:Name="WeeklyDot"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="WeeklyTitle"
                                FontSize="10"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            x:Name="WeeklyPercent"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="WeeklyReset"
                            FontSize="9"
                            Text="--" />
                    </StackPanel>
                </Grid>

                <!-- footer -->
                <Grid Grid.Row="2">
                    <TextBlock
                        x:Name="FooterText"
                        FontSize="10"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="RefreshButton"
                        Width="24"
                        Height="24"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnRefreshClick"
                        Content="&#xE72C;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11" />
                </Grid>
            </Grid>
        </Border>

        <!-- mini floating card -->
        <Border
            x:Name="MiniBorder"
            Width="118"
            Height="118"
            Padding="10"
            CornerRadius="16"
            Visibility="Collapsed"
            DoubleTapped="OnMiniDoubleTapped">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                <Grid Width="64" Height="64">
                    <Ellipse x:Name="MiniTrack" Width="60" Height="60" StrokeThickness="8" />
                    <Ellipse
                        x:Name="MiniRing"
                        Width="60"
                        Height="60"
                        StrokeThickness="8"
                        StrokeDashCap="Round"
                        RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock
                    x:Name="MiniPercent"
                    FontSize="10"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="MiniLabel"
                    FontSize="8"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
