<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:BrainFuel.Controls"
        xmlns:vm="clr-namespace:BrainFuel.ViewModels"
        x:Class="BrainFuel.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BrainFuel"
        Width="368" Height="226"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowDecorations="None"
        Topmost="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">

    <Window.Styles>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.quotaAction">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Styles>

    <Border x:Name="CardBorder"
            CornerRadius="16"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            PointerPressed="Card_PointerPressed"
            PointerReleased="Card_PointerReleased">
        <Border.ContextMenu>
            <ContextMenu x:Name="CardMenu">
                <MenuItem Header="{DynamicResource MenuRefresh}" Click="Refresh_Click"/>
                <MenuItem Header="{DynamicResource MenuSettings}" Click="Settings_Click"/>
                <MenuItem x:Name="UpdateMenuItem" Header="{DynamicResource MenuCheckUpdates}" Click="Update_Click"/>
                <Separator/>
                <MenuItem x:Name="TopmostMenuItem" Click="ToggleTopmost_Click"/>
                <MenuItem x:Name="MoveNextDisplayMenuItem" Header="{DynamicResource MenuMoveNextDisplay}" Click="MoveNextDisplay_Click"/>
                <MenuItem Header="{DynamicResource MenuMovePrimary}" Click="MovePrimary_Click"/>
                <Separator/>
                <MenuItem x:Name="AboutMenuItem" Header="About BrainFuel…" Click="About_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource MenuHide}" Click="Hide_Click"/>
                <MenuItem Header="{DynamicResource MenuQuit}" Click="Quit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Border Background="{DynamicResource CardBg}" Opacity="{Binding CardOpacity}" CornerRadius="16"/>

            <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="BrainFuel" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource CardSubtitle}" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <Button x:Name="MenuButton" Grid.Column="1" Classes="ghost"
                            Click="OpenMenu_Click" ToolTip.Tip="{DynamicResource MenuMoreTip}"
                            VerticalAlignment="Top">
                        <TextBlock Text="⋯" FontSize="18" LineHeight="16"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="124,*" ColumnSpacing="14">
                    <ctl:UsageRing Grid.Column="0"
                                   Width="116" Height="116"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TrackBrush="{DynamicResource RingTrack}"
                                   WeeklyBrush="{DynamicResource RingWeekly}"
                                   HourlyBrush="{DynamicResource RingHourly}"
                                   WeeklyProgress="{Binding WeeklyProgress}"
                                   HourlyProgress="{Binding HourlyProgress}"/>

                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="10,8" Background="{DynamicResource HoverOverlay}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource RingHourly}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource LblHourly}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HourlyPercentText}"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding HourlySubText}"
                                           Margin="12,1,0,0" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            </Grid>
                        </Border>

                        <Border CornerRadius="10" Padding="10,8" Background="{DynamicResource HoverOverlay}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource RingWeekly}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource LblWeekly}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WeeklyPercentText}"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding WeeklySubText}"
                                           Margin="12,1,0,0" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource QuotaDataStatus}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding RefreshAgoText}" FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="quotaAction" Click="Refresh_Click"
                            IsEnabled="{Binding CanRefresh}"
                            Content="{DynamicResource BtnRefreshQuota}" ToolTip.Tip="{DynamicResource BtnRefreshQuota}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
