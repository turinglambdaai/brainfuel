<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BrainFuel.AboutWindow"
        Width="410" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="Full">

    <Grid RowDefinitions="*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="BrainFuel" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="VersionText" FontSize="13"
                           Foreground="{DynamicResource RingWeekly}"/>
            </StackPanel>

            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>

            <Border CornerRadius="10" Padding="12,10"
                    Background="{DynamicResource HoverOverlay}"
                    BorderBrush="{DynamicResource Separator}" BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock x:Name="BuildText" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="LicenseText" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,18,0,0">
            <Button x:Name="SourceButton" Grid.Column="0" Click="OpenSource_Click"/>
            <Button x:Name="ReleasesButton" Grid.Column="1" Click="OpenReleases_Click"/>
            <Button x:Name="CloseButton" Grid.Column="3" Classes="accent" Click="Close_Click"
                    MinWidth="86"/>
        </Grid>
    </Grid>
</Window>
